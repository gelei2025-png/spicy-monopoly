# 复制成 .env 再改：cp .env.example .env
# docker compose 会自动读同目录下的 .env

# ── 时区 ──
TZ=Asia/Shanghai

# ── HTTP API ──
# 默认只绑本机，安全。想用局域网 IP 直接访问就改 0.0.0.0，
# 但那等于同网段谁都能开局 / 查局 —— 公开前请挂反代加鉴权。
API_BIND=127.0.0.1
API_PORT=8069

# ── 远程 MCP ──
MCP_BIND=127.0.0.1
MCP_PORT=3000

# 公开部署强烈建议设一个随机 token，客户端需要带
#   Authorization: Bearer <token>
# 留空 = 不校验，任何人都能连上来开局。
# 生成：openssl rand -hex 32
MCP_BEARER_TOKEN=
